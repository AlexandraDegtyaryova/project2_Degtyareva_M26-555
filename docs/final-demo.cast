[9.671, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[9.671, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+"]
[9.671, "o", "\r\n"]
[9.671, "o", ">>>Введите команду: "]
[10.375, "o", "\u001b[32;21Hdelete from users where ID = 1\u001b[32;51H"]
[10.375, "o", "\u001b[32;51H\r\n"]
[10.375, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[10.375, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[11.078, "o", "\u001b[32;61Hn\u001b[32;62H"]
[11.078, "o", "\u001b[32;62H\r\nОперация \"удаление записей\" отменена.\r\n"]
[11.078, "o", ">>>Введите команду: "]
