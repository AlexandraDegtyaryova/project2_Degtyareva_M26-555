[2.656, "o", "> "]
[3.359, "o", "\u001b[9;3Hdatabase\u001b[9;11H"]
[3.359, "o", "\u001b[9;11H\r\n"]
[3.359, "o", "\u001b]0;C:\\WINDOWS\\system32\\cmd.exe - database\u001b\\"]
[3.75, "o", "***База данных***\r\n"]
[3.75, "o", "\r\n***Процесс работы с таблицей***\r\n<command> create_table <имя> <столбец:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя> - удалить таблицу\r\n"]
[3.75, "o", "\r\n***Операции с данными***\r\n<command> insert into <имя> values (<значение1>, ...) - создать запись\r\n<command> select from <имя> [where <столбец> = <значение>] - прочитать\r\n"]
[3.75, "o", "<command> update <имя> set <столбец> = <значение> where ... - обновить\r\n<command> delete from <имя> where <столбец> = <значение> - удалить\r\n<command> info <имя> - информация о таблице\r\n\r\nОбщие команды:"]
[3.75, "o", "\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[3.765, "o", ">>>Введите команду: "]
[4.453, "o", "\u001b[28;21Hcreate_table users name:str age:int is_active:bool\u001b[28;71H"]
[4.468, "o", "\u001b[28;71H\r\n"]
[4.468, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[4.468, "o", ">>>Введите команду: "]
[5.171, "o", "\u001b[30;21Hinsert into users values (\"Wrong type\", true, false)\u001b[30;73H"]
[5.171, "o", "\u001b[30;73H\r\n"]
[5.171, "o", "Функция insert выполнилась за 0.000 секунд\r\nОшибка валидации: age ожидает int, получено True\r\n"]
[5.171, "o", ">>>Введите команду: "]
[5.875, "o", "\u001b[32;21Hinsert into users values (\"Sergei\", 28, true)\u001b[32;66H"]
[5.875, "o", "\u001b[32;66H\r\n"]
[5.875, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[5.875, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[5.875, "o", ">>>Введите команду: "]
[6.578, "o", "\u001b[32;21Hselect from users where age = 28\u001b[32;53H"]
[6.578, "o", "\u001b[32;53H\r\n"]
[6.578, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[6.828, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+"]
[6.828, "o", "\r\n"]
[6.828, "o", ">>>Введите команду: "]
[7.531, "o", "\u001b[32;21Hselect from users where age = 28\u001b[32;53H"]
[7.531, "o", "\u001b[32;53H\r\n"]
[7.531, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[7.531, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+"]
[7.546, "o", "\r\n"]
[7.546, "o", ">>>Введите команду: "]
[8.25, "o", "\u001b[32;21Hupdate users set age = 29 where ID = 1\u001b[32;59H"]
[8.25, "o", "\u001b[32;59H\r\n"]
[8.25, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[8.25, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n"]
[8.25, "o", ">>>Введите команду: "]
[8.953, "o", "\u001b[32;21Hselect from users where age = 28\u001b[32;53H"]
[8.953, "o", "\u001b[32;53H\r\n"]
[8.968, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[8.968, "o", "+----+------+-----+-----------+\r\n| ID | name | age | is_active |\r\n+----+------+-----+-----------+\r\n+----+------+-----+-----------+"]
[8.968, "o", "\r\n"]
[8.968, "o", ">>>Введите команду: "]
[9.671, "o", "\u001b[32;21Hselect from users where age = 29\u001b[32;53H"]
