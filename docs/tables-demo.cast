[2.578, "o", "2 executable"]
[2.578, "o", "s: database"]
[2.578, "o", ", project\r\n"]
[2.578, "o", "\u001b]0;C:\\WINDOWS\\system32\\cmd.exe\u001b\\"]
[2.578, "o", "\r\n"]
[2.578, "o", "> "]
[2.578, "o", "\u001b[16;3Hdatabase\u001b[16;11H"]
[2.578, "o", "\u001b[16;11H\r\n"]
[2.594, "o", "\u001b]0;C:\\WINDOWS\\system32\\cmd.exe - database\u001b\\"]
[2.875, "o", "***База данных***\r\n"]
[2.875, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n"]
[2.875, "o", "<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n"]
[2.875, "o", "<command> help - справочная информация\r\n\r\n"]
[2.875, "o", ">>>Введите команду: "]
[3.578, "o", "\u001b[29;21Hcreate_table users name:str age:int is_active:bool\u001b[29;71H"]
[3.578, "o", "\u001b[29;71H\r\n"]
[3.578, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[3.578, "o", ">>>Введите команду: "]
[4.281, "o", "\u001b[31;21Hcreate_table users name:str\u001b[31;48H"]
[4.281, "o", "\u001b[31;48H\r\n"]
[4.281, "o", "Ошибка: Таблица \"users\" уже существует.\r\n"]
[4.281, "o", ">>>Введите команду: "]
[4.984, "o", "\u001b[32;21Hlist_tables\u001b[32;32H"]
[4.984, "o", "\u001b[32;32H\r\n- users\r\n"]
[4.984, "o", ">>>Введите команду: "]
[5.687, "o", "\u001b[32;21Hexit\u001b[32;25H"]
[5.687, "o", "\u001b[32;25H\r\n"]
[5.703, "o", "\u001b]0;C:\\WINDOWS\\system32\\cmd.exe\u001b\\"]
[5.703, "o", "\r\n"]
[5.703, "o", "> "]
[6.406, "o", "\u001b[32;3Hdatabase\u001b[32;11H"]
[6.406, "o", "\u001b[32;11H\r\n"]
[6.406, "o", "\u001b]0;C:\\WINDOWS\\system32\\cmd.exe - database\u001b\\"]
[6.547, "o", "***База данных***\r\n"]
[6.562, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n"]
[6.562, "o", "<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\nОбщие команды:"]
[6.562, "o", "\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[6.562, "o", ">>>Введите команду: "]
[7.265, "o", "\u001b[32;21Hlist_tables\u001b[32;32H"]
[7.265, "o", "\u001b[32;32H\r\n"]
[7.265, "o", "- users\r\n"]
[7.265, "o", ">>>Введите команду: "]
[7.969, "o", "\u001b[32;21Hdrop_table users\u001b[32;37H"]
[7.969, "o", "\u001b[32;37H\r\nТаблица \"users\" успешно удалена.\r\n"]
[7.969, "o", ">>>Введите команду: "]
[8.672, "o", "\u001b[32;21Hdrop_table products\u001b[32;40H"]
[8.672, "o", "\u001b[32;40H\r\n"]
[8.672, "o", "Ошибка: Таблица \"products\" не существует.\r\n"]
[8.672, "o", ">>>Введите команду: "]
[9.375, "o", "\u001b[32;21Hlist_tables\u001b[32;32H"]
[9.375, "o", "\u001b[32;32H\r\nТаблиц пока нет.\r\n"]
[9.375, "o", ">>>Введите команду: "]
[10.078, "o", "\u001b[32;21Hhelp\u001b[32;25H"]
[10.078, "o", "\u001b[32;25H\r\n"]
[10.078, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n"]
[10.094, "o", "<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n"]
[10.094, "o", "\r\nОбщие команды:\r\n"]
[10.094, "o", "<command> exit - выход из программы\r\n<command> help - справочная информация\r\n"]
[10.094, "o", "\r\n"]
[10.094, "o", ">>>Введите команду: "]
[10.797, "o", "\u001b[32;21Hexit\u001b[32;25H"]
[10.797, "o", "\u001b[32;25H\r\n"]
[10.812, "o", "\u001b]0;C:\\WINDOWS\\system32\\cmd.exe\u001b\\"]
[10.812, "o", "\r\n"]
[10.812, "o", "> "]
