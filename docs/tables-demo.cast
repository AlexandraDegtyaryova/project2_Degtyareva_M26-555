[2.578, "o", "file:///C:/Users/Admin/OneDrive/%D0%94%D0%BE%D0%BA%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D1%8B/ChatGPT/%D0%BF%D0%B8%D1%82%D0%BE%D0%BD/work/demo-session-pt70eoyd/primitive_db-0.1.0-py3-none-any.whl)"]
