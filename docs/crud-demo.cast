[4.109, "o", "***База данных***\r\n"]
[4.109, "o", "\r\n***Процесс работы с таблицей***\r\n<command> create_table <имя> <столбец:тип> .. - создать таблицу\r\n"]
[4.109, "o", "<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя> - удалить таблицу\r\n\r\n***Операции с данными***\r\n"]
[4.109, "o", "<command> insert into <имя> values (<значение1>, ...) - создать запись\r\n<command> select from <имя> [where <столбец> = <значение>] - прочитать\r\n"]
[4.109, "o", "<command> update <имя> set <столбец> = <значение> where ... - обновить\r\n<command> delete from <имя> where <столбец> = <значение> - удалить\r\n<command> info <имя> - информация о таблице\r\n\r\nОбщие команды:\r\n"]
[4.109, "o", "<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[4.109, "o", ">>>Введите команду: "]
[4.812, "o", "\u001b[32;21Hcreate_table users name:str age:int is_active:bool\u001b[32;71H"]
[4.812, "o", "\u001b[32;71H\r\n"]
[4.812, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[4.812, "o", ">>>Введите команду: "]
[5.515, "o", "\u001b[32;21Hinsert into users values (\"Sergei\", 28, true)\u001b[32;66H"]
[5.531, "o", "\u001b[32;66H\r\n"]
[5.531, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[5.531, "o", ">>>Введите команду: "]
[6.234, "o", "\u001b[32;21Hinsert into users values (\"Anna, Smith\", 31, false)\u001b[32;72H"]
[6.234, "o", "\u001b[32;72H\r\n"]
[6.234, "o", "Запись с ID=2 успешно добавлена в таблицу \"users\".\r\n"]
[6.234, "o", ">>>Введите команду: "]
[6.937, "o", "\u001b[32;21Hselect from users where age = 28\u001b[32;53H"]
[6.937, "o", "\u001b[32;53H\r\n"]
[7.187, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+"]
[7.187, "o", "\r\n"]
[7.187, "o", ">>>Введите команду: "]
[7.89, "o", "\u001b[32;21Hupdate users set age = 29 where name = \"Sergei\"\u001b[32;68H"]
[7.89, "o", "\u001b[32;68H\r\n"]
[7.89, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n"]
[7.89, "o", ">>>Введите команду: "]
[8.593, "o", "\u001b[32;21Hselect from users\u001b[32;38H"]
[8.593, "o", "\u001b[32;38H\r\n"]
[8.609, "o", "+----+-------------+-----+-----------+\r\n| ID |     name    | age | is_active |\r\n+----+-------------+-----+-----------+\r\n| 1  |    Sergei   |  29 |    True   |\r\n| 2  | Anna, Smith |  31 |   False   |\r\n+----+-------------+-----+-----------+"]
[8.609, "o", "\r\n"]
[8.609, "o", ">>>Введите команду: "]
[9.312, "o", "\u001b[32;21Hexit\u001b[32;25H"]
[9.312, "o", "\u001b[32;25H\r\n"]
[9.328, "o", "\u001b]0;C:\\WINDOWS\\system32\\cmd.exe\u001b\\"]
[9.328, "o", "\r\n"]
[9.343, "o", "> "]
[10.031, "o", "\u001b[32;3Hdatabase\u001b[32;11H"]
[10.031, "o", "\u001b[32;11H\r\n"]
[10.047, "o", "\u001b]0;C:\\WINDOWS\\system32\\cmd.exe - database\u001b\\"]
[10.218, "o", "***База данных***\r\n"]
[10.234, "o", "\r\n***Процесс работы с таблицей***\r\n<command> create_table <имя> <столбец:тип> .. - создать таблицу\r\n"]
[10.234, "o", "<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя> - удалить таблицу\r\n\r\n***Операции с данными***\r\n"]
[10.234, "o", "<command> insert into <имя> values (<значение1>, ...) - создать запись\r\n<command> select from <имя> [where <столбец> = <значение>] - прочитать\r\n<command> update <имя> set <столбец> = <значение> where ... - обновить\r\n<command> delete from <имя> where <столбец> = <значение> - удалить\r\n"]
[10.234, "o", "<command> info <имя> - информация о таблице\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n"]
[10.234, "o", "<command> help - справочная информация\r\n\r\n"]
[10.234, "o", ">>>Введите команду: "]
[10.937, "o", "\u001b[32;21Hselect from users\u001b[32;38H"]
[10.937, "o", "\u001b[32;38H\r\n"]
[11.031, "o", "+----+-------------+-----+-----------+\r\n| ID |     name    | age | is_active |\r\n+----+-------------+-----+-----------+\r\n| 1  |    Sergei   |  29 |    True   |\r\n| 2  | Anna, Smith |  31 |   False   |\r\n+----+-------------+-----+-----------+"]
[11.047, "o", "\r\n"]
[11.047, "o", ">>>Введите команду: "]
[11.75, "o", "\u001b[32;21Hdelete from users where ID = 1\u001b[32;51H"]
[11.75, "o", "\u001b[32;51H\r\n"]
[11.75, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\n"]
[11.75, "o", ">>>Введите команду: "]
[12.453, "o", "\u001b[32;21Hselect from users\u001b[32;38H"]
[12.453, "o", "\u001b[32;38H\r\n"]
[12.468, "o", "+----+-------------+-----+-----------+\r\n| ID |     name    | age | is_active |\r\n+----+-------------+-----+-----------+\r\n| 2  | Anna, Smith |  31 |   False   |\r\n+----+-------------+-----+-----------+"]
[12.468, "o", "\r\n"]
[12.468, "o", ">>>Введите команду: "]
[13.172, "o", "\u001b[32;21Hinfo users\u001b[32;31H"]
[13.172, "o", "\u001b[32;31H\r\n"]
[13.172, "o", "Таблица: users\r\n"]
[13.172, "o", "Столбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 1\r\n"]
[13.187, "o", ">>>Введите команду: "]
[13.875, "o", "\u001b[32;21Hinsert into users values (\"Wrong type\", true, false)\u001b[32;73H"]
[13.875, "o", "\u001b[32;73H\r\n"]
[13.89, "o", "Некорректное значение: age ожидает int, получено True. Попробуйте снова.\r\n"]
[13.89, "o", ">>>Введите команду: "]
[14.593, "o", "\u001b[32;21Hinsert into users values (\"New user\", 20, true)\u001b[32;68H"]
[14.593, "o", "\u001b[32;68H\r\n"]
[14.593, "o", "Запись с ID=3 успешно добавлена в таблицу \"users\".\r\n"]
[14.593, "o", ">>>Введите команду: "]
[15.297, "o", "\u001b[32;21Hselect from users\u001b[32;38H"]
[15.297, "o", "\u001b[32;38H\r\n"]
[15.312, "o", "+----+-------------+-----+-----------+\r\n| ID |     name    | age | is_active |\r\n+----+-------------+-----+-----------+\r\n| 2  | Anna, Smith |  31 |   False   |\r\n| 3  |   New user  |  20 |    True   |\r\n+----+-------------+-----+-----------+"]
[15.312, "o", "\r\n"]
[15.312, "o", ">>>Введите команду: "]
[16.015, "o", "\u001b[32;21Hdelete from users where is_active = false\u001b[32;62H"]
[16.015, "o", "\u001b[32;62H\r\n"]
[16.015, "o", "Запись с ID=2 успешно удалена из таблицы \"users\".\r\n"]
[16.015, "o", ">>>Введите команду: "]
[16.718, "o", "\u001b[32;21Hdelete from users where is_active = true\u001b[32;61H"]
[16.718, "o", "\u001b[32;61H\r\n"]
[16.734, "o", "Запись с ID=3 успешно удалена из таблицы \"users\".\r\n"]
[16.734, "o", ">>>Введите команду: "]
[17.437, "o", "\u001b[32;21Hinfo users\u001b[32;31H"]
[17.437, "o", "\u001b[32;31H\r\n"]
[17.437, "o", "Таблица: users\r\n"]
[17.437, "o", "Столбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 0\r\n"]
[17.437, "o", ">>>Введите команду: "]
